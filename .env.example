# Copy this file to .env.local and fill in your own Supabase project's values
# (Dashboard -> Project Settings -> API). The anon/public key is safe for
# client-side code — never put the service_role key here or in any client code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
